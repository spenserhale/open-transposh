{
  "name": "open-transposh",
  "version": "2.1.7",
  "private": true,
  "description": "Local development environment for the Open Transposh WordPress plugin",
  "scripts": {
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:clean": "wp-env destroy && wp-env start",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/open-transposh ./vendor/bin/phpunit",
    "test:php:install": "wp-env run tests-cli --env-cwd=wp-content/plugins/open-transposh composer install"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wordpress/env": "^12.1.0"
  }
}
